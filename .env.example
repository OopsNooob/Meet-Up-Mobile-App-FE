# Copy thành .env (đã bị .gitignore). Biến EXPO_PUBLIC_* được nhúng vào bundle — KHÔNG để secret ở đây.

# Base URL của backend (Android emulator: 10.0.2.2 = localhost của máy dev)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Mặc định dùng mock auth (không cần backend). Đặt false khi BE-01 sẵn sàng.
EXPO_PUBLIC_USE_MOCK_API=true